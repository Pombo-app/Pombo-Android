<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        Read access to the photo library, for the attach → Image grid. The
        system photo picker needs none of this, but it is a closed Activity
        with no way to host a camera tile, so the grid is ours and has to
        query MediaStore itself. Refusal is handled: the sheet falls back to
        the camera plus a Browse… entry into the system picker.

        Three permissions because the model changed twice: READ_EXTERNAL_STORAGE
        up to Android 12, READ_MEDIA_IMAGES on 13, and on 14+ the user may grant
        _VISUAL_USER_SELECTED instead — access to a hand-picked subset, which
        MediaStore then transparently limits the query to.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!--
        NOTE: no CAMERA permission, on purpose. The camera tile hands off to the
        device's camera app through ACTION_IMAGE_CAPTURE, which needs no grant —
        and declaring CAMERA would actively make things worse, because Android
        then starts requiring a runtime grant before that intent works.
    -->

    <!-- Android 11+ package visibility: without this, getLaunchIntentForPackage
         returns null for MetaMask even when it IS installed, and "Fund with
         MetaMask" wrongly falls through to the Play Store. -->
    <queries>
        <package android:name="io.metamask" />
    </queries>

    <application
        android:label="Pombo"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Pombo"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Pombo.Splash"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Invite links. The web puts the token in the fragment
                (app.pombo.cc/#/invite/<token>), which Android never matches on
                — the fragment is not part of intent filtering. So we accept the
                host and read the fragment ourselves in onNewIntent.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.pombo.cc" />
            </intent-filter>
            <!-- Custom scheme, for links shared outside a browser context. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pombo" android:host="invite" />
            </intent-filter>
        </activity>

        <!-- YouTube player. MUST live in its own process: sharing one with the
             bridge's headless WebView renders video as sound over a black
             picture (proven by isolation — see YtProbeActivity's kdoc). -->
        <activity
            android:name=".YtProbeActivity"
            android:process=":player"
            android:theme="@android:style/Theme.Black.NoTitleBar"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:exported="false" />

        <!-- Relay wake signals. Data-only, so onMessageReceived runs and can
             discard the false positives the 1-byte tag inevitably produces. -->
        <service
            android:name=".push.PomboMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Holds the process (bridge WebView + transfer engine) while file
             transfers run with the UI in the background. -->
        <service
            android:name=".MediaTransferService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Gives the camera app a writable target for the capture. Exposes
             nothing but cacheDir/camera/ — see res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
    </application>
</manifest>
